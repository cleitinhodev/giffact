{
  "name": "giffact",
  "productName": "Giffact",
  "version": "1.1.1",
  "description": "Giffact — trace animated GIFs frame by frame with clean vector linework (PaintTool SAI style) and export PNG/SVG at any size.",
  "main": "app/main.js",
  "desktopName": "giffact.desktop",
  "author": {
    "name": "cleitinhodev",
    "url": "https://github.com/cleitinhodev"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node build.mjs && electron .",
    "test": "node test/e2e.mjs",
    "test:electron": "node test/electron-smoke.mjs",
    "test:layout": "node test/layout.mjs",
    "test:layout:electron": "node test/layout.mjs electron",
    "dist:win": "node build.mjs --minify && electron-builder --win zip portable --x64",
    "web": "node build.mjs && npx --yes http-server app -p 8080",
    "test:features": "node test/features.mjs",
    "test:features:electron": "node test/features.mjs electron",
    "test:i18n": "node test/i18n.mjs",
    "test:all": "npm run typecheck && npm run build && npm run test:i18n && npm test && npm run test:features && npm run test:layout && npm run test:electron && npm run test:features:electron && npm run test:layout:electron",
    "dist:linux": "node build.mjs --minify && electron-builder --linux AppImage tar.gz deb --x64",
    "test:linux": "node test/linux-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "electron": "41.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "1.50",
    "typescript": "^7.0.2",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2"
  },
  "allowScripts": {
    "electron@41.7.1": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.cleitinhodev.giffact",
    "productName": "Giffact",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Giffact-${version}-windows-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Giffact-${version}-windows-portable.exe"
    },
    "artifactName": "Giffact-${version}-win-${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": "giffact",
        "name": "Giffact project",
        "description": "Giffact project",
        "icon": "build/icon.ico",
        "mimeType": "application/x-giffact"
      },
      {
        "ext": "gifline",
        "name": "Giffact project (legacy)",
        "description": "Giffact project (legacy .gifline)",
        "icon": "build/icon.ico",
        "mimeType": "application/x-gifline"
      }
    ],
    "copyright": "Copyright © 2026 cleitinhodev",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Graphics",
      "executableName": "giffact",
      "artifactName": "Giffact-${version}-linux-${arch}.${ext}",
      "synopsis": "Trace animated GIFs with clean vector linework",
      "description": "Giffact: trace animated GIFs frame by frame with clean, pressure-sensitive vector linework (PaintTool SAI style) and export PNG/SVG at any resolution.",
      "maintainer": "cleitinhodev <139408626+cleitinhodev@users.noreply.github.com>",
      "vendor": "cleitinhodev",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Giffact",
          "GenericName": "GIF Linework Tracer",
          "Comment": "Trace animated GIFs with clean vector linework and export PNG/SVG",
          "Categories": "Graphics;2DGraphics;VectorGraphics;",
          "Keywords": "gif;linework;lineart;trace;animation;vector;"
        }
      }
    },
    "appImage": {
      "artifactName": "Giffact-${version}-linux-x86_64.AppImage"
    },
    "deb": {
      "artifactName": "Giffact-${version}-linux-amd64.deb"
    }
  },
  "homepage": "https://github.com/cleitinhodev/giffact",
  "repository": {
    "type": "git",
    "url": "https://github.com/cleitinhodev/giffact.git"
  },
  "bugs": {
    "url": "https://github.com/cleitinhodev/giffact/issues"
  }
}
